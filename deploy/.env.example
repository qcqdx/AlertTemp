# Скопируйте в .env рядом с docker-compose.yml и заполните.

# Пароль пользователя БД (обязателен)
COLDWATCH_DB_PASSWORD=change-me

# Адрес MQTT-брокера, куда публикуют контроллеры.
# По умолчанию — встроенный сервис mqtt из docker-compose.
# Для внешнего брокера: COLDWATCH_MQTT_HOST=10.10.0.3
#COLDWATCH_MQTT_HOST=10.10.0.3
#COLDWATCH_MQTT_PORT=1883

# Фильтр подписки. Сузьте, если известен общий префикс топиков контроллеров.
#COLDWATCH_MQTT_TOPIC_FILTER=#

# Telegram-оповещения: токен бота (@BotFather). Пусто = канал выключен.
#COLDWATCH_TELEGRAM_BOT_TOKEN=123456:ABC-DEF...

# SOCKS5-прокси для api.telegram.org — обязателен, если прямой доступ
# из сети блокируется (как на стенде): socks5://user:pass@host:1080
#COLDWATCH_TELEGRAM_PROXY=socks5://10.10.0.1:1080

# Часовой пояс отображения времени в оповещениях и отчётах
#COLDWATCH_DISPLAY_TIMEZONE=Europe/Moscow

# Пароль первичного администратора (логин admin), применяется один раз при
# пустой базе пользователей. Не задан — пароль генерируется в лог контейнера.
#COLDWATCH_ADMIN_PASSWORD=change-me-please
